{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "test:scoring": "esbuild src/telegram/scoring.test.ts --bundle --platform=node --format=esm --outfile=/tmp/fpl-scoring.test.mjs && node /tmp/fpl-scoring.test.mjs",
    "test:team-registration": "esbuild src/telegram/team-registration.integration.test.ts --bundle --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; globalThis.require = createRequire(import.meta.url);\" --outfile=/tmp/fpl-team.test.mjs && node /tmp/fpl-team.test.mjs",
    "test:signal": "esbuild src/telegram/signal.test.ts --bundle --platform=node --format=esm --outfile=/tmp/fpl-signal.test.mjs && node /tmp/fpl-signal.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:prizes": "esbuild src/telegram/prize-distribution.test.ts --bundle --platform=node --format=esm --outfile=/tmp/fpl-prize.test.mjs && node /tmp/fpl-prize.test.mjs"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
